# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=code_connect
MYSQL_USER=app
MYSQL_PASSWORD=app

# Backend
API_PORT=8080
CORS_ORIGIN=http://localhost:5173

# Autenticação
# JWT_SECRET: no mínimo 32 bytes; a API não sobe sem ele. Troque em qualquer ambiente real.
JWT_SECRET=troque-este-segredo-em-qualquer-ambiente-real
JWT_TTL=24h
JWT_REMEMBER_TTL=720h
BCRYPT_COST=12
# COOKIE_SECURE=true em produção (HTTPS)
COOKIE_SECURE=false

# Documentação da API em /api/docs/index.html (deixe false em produção)
SWAGGER_ENABLED=true

# Portas expostas no host
FRONTEND_PORT=5173
MYSQL_PORT=3307
